# The user the package is installed for: the one who ran sudo, or pkexec
# (Linexin Hello's LineXinBar page installs with pkexec, which sets no
# SUDO_USER). Empty from a root shell or a chroot: nothing is copied then.
installing_user()
{
   if [ -n "${SUDO_USER:-}" ] && [ "$SUDO_USER" != root ]; then
      printf '%s\n' "$SUDO_USER"
   elif [ -n "${PKEXEC_UID:-}" ] && [ "$PKEXEC_UID" != 0 ]; then
      getent passwd "$PKEXEC_UID" | cut -d: -f1
   fi
}

post_install()
{
   user=$(installing_user)
   [ -n "$user" ] || return 0
   user_home=$(getent passwd "$user" | cut -d: -f6)
   [ -n "$user_home" ] && [ -d "$user_home" ] || return 0
   #rm -rf "$user_home/.local/share/linexin"
   mkdir -p "$user_home/.local/share/linexin/linexin-desktop"
   cp -rf /etc/skel/.local/share/linexin/linexin-desktop "$user_home/.local/share/linexin"
   chown -R "$user:" "$user_home/.local/share/linexin"
   chmod 755 "$user_home/.local/share/linexin" -R
}

post_upgrade()
{
    post_install
}
